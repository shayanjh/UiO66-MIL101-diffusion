# =====================================================================
# MD-GCMC coadsorption of H2O and CO2 in UiO-66
#
# Starts from a snapshot loaded with water alone at the chosen relative
# humidity (gcmc/in.gcmc_UiO66_H2O, reservoir pressure RH x P_sat(T)), and
# exchanges both H2O and CO2 with reservoirs at fixed partial pressures,
# framework NVT + rigid guests NVT. The numbers of molecules are printed
# every 1000 steps (check that both are flat before using the snapshot).
# The final configuration is the starting point of
# msd_uff/in.msd_UiO66_H2O_CO2.
#
# Atom types: 1-5 framework, 6-7 H2O (from the water-loaded snapshot),
# 8-9 CO2 (added here).
# =====================================================================

# ----------------- USER INPUTS -----------------
#   lmp -var datafile water_loaded.data -var P_H2O 0.0125 -var P_CO2 0.981 ... -in in.gcmc_UiO66_H2O_CO2
variable datafile   index {datafile}     # UiO-66 snapshot loaded with water at the chosen RH
variable out_file   index {out_file}     # data file written at the end
variable Tf         index {Tf}           # temperature (K)
variable P_H2O      index {P_H2O}        # water reservoir pressure (atm) = RH x P_sat(T)
variable P_CO2      index {P_CO2}        # CO2 fugacity (atm)
variable seed_H2O   index {seed_H2O}     # random seeds of the two fix gcmc commands
variable seed_CO2   index {seed_CO2}
variable n_steps    index {n_steps}      # MD-GCMC steps (e.g., a few million; extend until both counts are flat)

units           real
atom_style      full
boundary        p p p
timestep        0.5                           # fs

pair_style      lj/cut/coul/long 14.5
bond_style      harmonic
angle_style     hybrid cosine/periodic fourier harmonic
dihedral_style  harmonic
improper_style  fourier
kspace_style    ewald 1.0e-4
kspace_modify   gewald 0.3

neighbor        2.0 nsq
neigh_modify    delay 0 every 1 check yes one 10000 page 200000
pair_modify     tail yes mix arithmetic
special_bonds   lj/coul 0.0 0.0 1.0
dielectric      1.0

read_data       ${datafile} &
                extra/atom/types 2 &
                extra/bond/types 1 &
                extra/angle/types 1 &
                extra/bond/per/atom 2 &
                extra/angle/per/atom 1 &
                extra/special/per/atom 2

group      FRAME type 1:5
group      H2O type 6 7
molecule   h2o H2O.txt toff 5 boff 7 aoff 14

mass       8 12.0107       # CO2 C
mass       9 15.9994       # CO2 O
pair_coeff 8 8 0.053649 2.8000
pair_coeff 9 9 0.156973 3.0500
bond_coeff 9 0.0 1.16
angle_coeff 16 harmonic 0.0 180.0
group      CO2 type 8 9
molecule   co2 CO2.txt toff 7 boff 8 aoff 15

variable Tdamp equal 100.0
fix frame_nvt FRAME nvt temp ${Tf} ${Tf} ${Tdamp}
fix nvt_H2O H2O rigid/nvt/small molecule temp ${Tf} ${Tf} ${Tdamp} mol h2o
fix_modify nvt_H2O dynamic/dof yes
fix nvt_CO2 CO2 rigid/nvt/small molecule temp ${Tf} ${Tf} ${Tdamp} mol co2
fix_modify nvt_CO2 dynamic/dof yes
compute_modify thermo_temp dynamic/dof yes

region box block EDGE EDGE EDGE EDGE EDGE EDGE
fix gcmc_H2O H2O gcmc 100 50 0 0 ${seed_H2O} ${Tf} 0.0 2.0 mol h2o group H2O rigid nvt_H2O &
    tfac_insert 1 full_energy region box pressure ${P_H2O} fugacity_coeff 1.0
fix gcmc_CO2 CO2 gcmc 100 50 0 0 ${seed_CO2} ${Tf} 0.0 2.0 mol co2 group CO2 rigid nvt_CO2 &
    tfac_insert 1 full_energy region box pressure ${P_CO2} fugacity_coeff 1.0

variable NH equal count(H2O)/3
variable NC equal count(CO2)/3
variable s  equal step
thermo       5000
thermo_style custom step temp pe v_NH v_NC
fix nlog all print 1000 "${s} ${NH} ${NC}" file N_vs_step.txt screen no title "# step N_H2O N_CO2"

run ${n_steps}
unfix gcmc_CO2
unfix gcmc_H2O
run 50000
write_data ${out_file}
